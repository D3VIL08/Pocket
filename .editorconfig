root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
# One flat, lexicographically sorted import block. Both IntelliJ and ktlint read this key, so the
# IDE's "optimize imports" and the detekt formatting check agree instead of fighting each other.
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.xml]
indent_size = 4
