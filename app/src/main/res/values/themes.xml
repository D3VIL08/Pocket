<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Compose theme does the real work; this exists so the window has sensible colours
      before the first frame, which is what stops the launch flash.
    -->
    <style name="Theme.Pocket" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
